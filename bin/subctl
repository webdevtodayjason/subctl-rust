#!/usr/bin/env bash
# subctl — launcher for the v4 Ink chat TUI.
#
# Resolves the bundle relative to the script so dev-mode works from the
# worktree without an install pass. The install-integrator worker rewrites
# the bundle path to ~/.local/lib/subctl-rust/ui/bundle.js once the install
# slice lands.
#
# Subcommands handled outside the TUI (daemon control, logs, version) will
# land in a follow-up; for now every invocation goes straight into chat.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)"
WORKSPACE_ROOT="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"
BUNDLE="${WORKSPACE_ROOT}/ui/chat-tui/dist/bundle.js"

if ! command -v node >/dev/null 2>&1; then
  echo "[subctl] node is required (Node 22+). Install via 'brew install node@22'." >&2
  exit 127
fi

if [[ ! -f "${BUNDLE}" ]]; then
  echo "[subctl] bundle not found at ${BUNDLE}." >&2
  echo "[subctl] run: (cd '${WORKSPACE_ROOT}/ui/chat-tui' && npm install && npm run build)" >&2
  exit 1
fi

exec node "${BUNDLE}" "$@"
